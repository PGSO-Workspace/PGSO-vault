specification {
  element person { style { shape person } }
  element system
  element external
  element container
  element component
}
model {
  human = person 'Interlocutor'
  tools = external 'Herramientas'
  host = system 'Agente de IA de voz' {
    description 'Aplicación que integra PGSO'
    agent = container 'Orquestador de voz' {
      description 'Recibe audio y propone llamadas'
    }
    runtime = container 'Runtime PGSO' {
      description 'Proceso Rust de referencia'
      signal = component 'Extractor' {
        description 'Signal · audio → lecturas'
      }
      core = component 'Motor de gobernanza' {
        description 'Baseline, persistencia y políticas'
      }
      actuator = component 'Actuador' {
        description 'Actuator · reconcile → catálogo'
      }
      dispatch = component 'Control de ejecución' {
        description 'Catálogo, permisos y aprobación'
      }
      audit = component 'Auditoría' {
        description 'Transiciones y resultados'
      }
    }
  }
  human -> host 'Conversación'
  host -> tools 'Llamadas autorizadas'
  human -> agent 'Audio'
  agent -> runtime 'Audio y llamadas propuestas'
  runtime -> tools 'Ejecución autorizada'
  agent -> signal 'Ventanas de audio'
  signal -> core 'Valor y confianza'
  core -> actuator 'Contribuciones activas'
  actuator -> dispatch 'Catálogo y directivas'
  agent -> dispatch 'Llamada propuesta'
  dispatch -> tools 'Callback autorizado'
  core -> audit 'Transiciones'
  dispatch -> audit 'Resultado'
}
views {
  view c1_context {
    title 'C1 · Agente de voz que integra PGSO'
    include human, host, tools
    autoLayout LeftRight
  }
  view c2_containers of host {
    title 'C2 · Integración con runtime externo'
    include human, agent, runtime, tools
    autoLayout LeftRight
  }
  view c3_components of runtime {
    title 'C3 · Responsabilidades de PGSO'
    include signal, core, actuator, dispatch, audit
    autoLayout LeftRight
  }
}
